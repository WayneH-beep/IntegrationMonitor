<Project Sdk="WixToolset.Sdk/4.0.4">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DefineConstants>ProductVersion=1.0.0;PublishDir=$(MSBuildThisFileDirectory)..\..\src\PafiIntegrationSystemMonitor\bin\$(Configuration)\net8.0-windows\</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.4" />
  </ItemGroup>
</Project>
